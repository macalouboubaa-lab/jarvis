# ============================================================
# .env.example — JARVIS (architecture A-cloud)
# ============================================================
# Modèle :
#   • Supabase = base de vérité (app runtime)
#   • Postgres local = tests uniquement (profil "test")
# Usage : cp .env.example .env puis remplir.
# ============================================================

# === Supabase (base de vérité — runtime app) ===
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_KEY=votre-cle-service-role-backend-only
SUPABASE_ANON_KEY=votre-cle-publique-anon
SUPABASE_JWT_SECRET=votre-secret-jwt-supabase

# === DATABASE_URL (app runtime) — Session Pooler Supabase ===
# ⚠️ Prends la "Session pooler" dans Dashboard → Settings → Database
# Port 5432 sur le pooler (PAS 6543 transaction mode).
# Format : postgresql+asyncpg://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres.votre-project-ref:MOT_DE_PASSE_SUPABASE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require

# === Tests locaux — Postgres Docker ===
# ⚠️ Ne pointe JAMAIS vers Supabase. Cette DB est jetable.
TEST_DATABASE_URL=postgresql+asyncpg://jarvis:CHANGE_ME_BEFORE_FIRST_RUN@localhost:5433/jarvis_test
POSTGRES_TEST_USER=jarvis
POSTGRES_TEST_PASSWORD=CHANGE_ME_BEFORE_FIRST_RUN
POSTGRES_TEST_DB=jarvis_test
# Port 5433 (pas 5432) pour éviter conflit avec un postgres local existant

# === Fournisseurs IA ===
OPENAI_API_KEY=sk-proj-votre-cle-openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MEM0_API_KEY=votre-cle-mem0

# === ElevenLabs (voix — laisser vide tant que non implémenté) ===
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# === Intégrations ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# === Backend ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000

# === n8n ===
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_BEFORE_FIRST_RUN